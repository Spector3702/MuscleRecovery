"""Upon obtaining the experimental sample data, we perform preprocessing on the EMG
signals. 
1) The initial step involves baseline correction, where we calculate the average value from
a 5-second segment of the recording. 
2) Following this, the signal undergoes bandpass filtering
within the frequency range of 20 to 500 Hz [9, 10]. 
3) Additionally, we employ a notch filter to
eliminate power line noise at 50 Hz [8, 10]."""

def preprocessing(
    t: np.ndarray,
    y: np.ndarray,
    *,
    sfreq: int = 1000,
    t_baseline: float = None,
    c_baseline: bool = False,
    l_pass: int = None,
    h_band: int = None,
    l_band: int = None,
    notch: int = None,
):
    data = y.copy()
    interval = t.copy()

    """1) The initial step involves baseline correction, where we calculate the average value from
a 5-second segment of the recording, we may experiment with changing 5 seconds to 2.5 & 7.5 """
    if t_baseline is not None:
        baseline_idx = np.argwhere(t >= t_baseline)[0][0]
        baseline = data[:baseline_idx]
        y0 = np.mean(baseline)
    else:
        y0 = np.mean(data)

    data = data - y0

    # Crop Baseline
    if c_baseline:
        data = data[baseline_idx:]
        interval = interval[baseline_idx:]


    """2) Following this, the signal undergoes bandpass filtering
within the frequency range of 20 to 500 Hz [9, 10]."""
    # Band-pass Filter
    if l_band is not None and h_band is not None:
        high = h_band / (sfreq / 2)
        low = l_band / (sfreq / 2)
        b, a = butter(4, [high, low], btype="bandpass")
        data = filtfilt(b, a, data)

    # Rectification
    data = np.abs(data)

    # Low-pass Filter
    if l_pass is not None:
        low = l_pass / (sfreq / 2)
        b, a = butter(4, low, btype="lowpass")
        data = filtfilt(b, a, data)

    # Notch Filter
    # In Europe its different is 50Hz
    # In USA its 60Hz
    #we use 50Hz

    """3) Additionally, we employ a notch filter to
eliminate power line noise at 50 Hz [8, 10]."""
    if notch in [50, 60]:
        b, a = iirnotch(notch, 30.0, sfreq)

    # Min-Max Normalization
    return interval, data  # (data - data.min()) / (data.max() - data.min())


