import numpy as np
from scipy.signal import butter, filtfilt, iirnotch
##What ChatGPT said
def baseline_correction(emg: np.ndarray, fs: float, baseline_seconds: float = 5.0,
                        baseline_start_sec: float = 0.0) -> np.ndarray:
    """
    Subtract mean of a baseline segment (default: first 5 seconds).
    emg shape: (n_samples,) or (n_samples, n_channels)
    """
    emg = np.asarray(emg)
    if emg.ndim == 1:
        emg = emg[:, None]  # -> (n_samples, 1)

    start = int(round(baseline_start_sec * fs))
    stop = int(round((baseline_start_sec + baseline_seconds) * fs))

    if stop > emg.shape[0]:
        raise ValueError(
            f"Baseline window [{baseline_start_sec}, {baseline_start_sec+baseline_seconds}]s "
            f"exceeds signal length {emg.shape[0]/fs:.2f}s."
        )

    baseline_mean = np.mean(emg[start:stop, :], axis=0, keepdims=True)
    corrected = emg - baseline_mean
    return corrected if corrected.shape[1] > 1 else corrected[:, 0]


def butter_bandpass_filter(emg: np.ndarray, fs: float, lowcut: float = 20.0,
                           highcut: float = 500.0, order: int = 4) -> np.ndarray:
    """
    Zero-phase Butterworth bandpass using filtfilt.
    """
    emg = np.asarray(emg)
    if emg.ndim == 1:
        emg = emg[:, None]

    nyq = 0.5 * fs
    if highcut >= nyq:
        raise ValueError(f"highcut ({highcut} Hz) must be < Nyquist ({nyq} Hz).")

    low = lowcut / nyq
    high = highcut / nyq
    b, a = butter(order, [low, high], btype="bandpass")
    filtered = filtfilt(b, a, emg, axis=0)
    return filtered if filtered.shape[1] > 1 else filtered[:, 0]


def notch_filter(emg: np.ndarray, fs: float, notch_freq: float = 50.0,
                 q: float = 30.0) -> np.ndarray:
    """
    IIR notch filter at notch_freq (default: 50 Hz). Zero-phase via filtfilt.
    Q controls notch sharpness (higher = narrower).
    """
    emg = np.asarray(emg)
    if emg.ndim == 1:
        emg = emg[:, None]

    nyq = 0.5 * fs
    w0 = notch_freq / nyq
    if not (0 < w0 < 1):
        raise ValueError(f"notch_freq ({notch_freq} Hz) must be between 0 and Nyquist ({nyq} Hz).")

    b, a = iirnotch(w0=w0, Q=q)
    filtered = filtfilt(b, a, emg, axis=0)
    return filtered if filtered.shape[1] > 1 else filtered[:, 0]


def preprocess_emg(emg: np.ndarray, fs: float,
                   baseline_seconds: float = 5.0,
                   bandpass_low: float = 20.0,
                   bandpass_high: float = 500.0,
                   notch_freq: float = 50.0,
                   notch_q: float = 30.0,
                   order: int = 4) -> np.ndarray:
    """
    Full pipeline:
      1) Baseline correction (mean over first 5 seconds by default)
      2) Bandpass 20-500 Hz
      3) Notch at 50 Hz
    """
    x = baseline_correction(emg, fs, baseline_seconds=baseline_seconds)
    x = butter_bandpass_filter(x, fs, lowcut=bandpass_low, highcut=bandpass_high, order=order)
    x = notch_filter(x, fs, notch_freq=notch_freq, q=notch_q)
    return x


